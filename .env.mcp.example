# Copy to .env.mcp.local. These are server-side variables; never use NEXT_PUBLIC for secrets.
# Modules: orbit, tickit_pos, mess (comma separated). Only enabled modules need credentials.
# Leaving ALTEIL_MODULES undefined preserves existing deployments: orbit only.
ALTEIL_MODULES=orbit
# Shared transport settings (ALTEIL_* takes precedence over the legacy ORBIT_MCP_* aliases).
ALTEIL_MCP_TRANSPORT=stdio
ALTEIL_MCP_READ_ONLY=false
# ALTEIL_MCP_TRANSPORT=http
# ALTEIL_MCP_HOST=0.0.0.0
# ALTEIL_MCP_PORT=3100
# ALTEIL_MCP_HTTP_TOKEN=
# ALTEIL_MCP_ALLOWED_HOSTS=127.0.0.1,localhost,mcp.tu-dominio.com
# ALTEIL_MCP_ALLOWED_ORIGINS=

# Orbit module (same variables and tool names as before).
ORBIT_POCKETBASE_URL=http://127.0.0.1:8090
ORBIT_USER_EMAIL=agente@tu-dominio.com
ORBIT_USER_PASSWORD=CAMBIA_ESTA_CONTRASENA
# Alternative to email/password: a users token (not a superuser token).
# ORBIT_USER_TOKEN=
# Optional: pin the account to one workspace, rejecting mismatches.
# ORBIT_ORGANIZATION_ID=

ORBIT_MCP_READ_ONLY=false
ORBIT_MCP_ALLOW_SECRETS=false

# The old ORBIT_MCP_TRANSPORT/HOST/PORT/HTTP_TOKEN/ALLOWED_HOSTS/ALLOWED_ORIGINS
# remain valid aliases when the corresponding ALTEIL_MCP_* variable is undefined.

# Tickit POS module: configure when ALTEIL_MODULES includes tickit_pos.
# Direct Supabase connection. No Tickit Express API or tk_ key is needed.
# TICKIT_POS_ENVIRONMENT=staging
# TICKIT_POS_SUPABASE_URL=https://SUPABASE-POS-STAGING
# TICKIT_POS_SERVICE_ROLE_KEY=<server_only_service_role_or_sb_secret_key>
# Platform-wide superadmin access: no tenant or venue pin.
# Select targets with tool arguments tenant_id / venue_id. Lists default to all companies.
# Legacy TICKIT_POS_TENANT_ID and TICKIT_POS_VENUE_ID are ignored.
# TICKIT_POS_READ_ONLY=false

# MESS module: reservations calendar in its own PocketBase instance.
# Enable with ALTEIL_MODULES=orbit,tickit_pos,mess (or mess alone).
# MESS_POCKETBASE_URL=https://pb.messigualada.com
# MESS_AUTH_COLLECTION=users
# MESS_USER_EMAIL=<mess_staff_email>
# MESS_USER_PASSWORD=<mess_staff_password>
# Alternative: use a token from the configured auth collection.
# MESS_USER_TOKEN=
# Use MESS_AUTH_COLLECTION=_superusers for a server-only superuser account/API token.
# MESS_READ_ONLY=false
