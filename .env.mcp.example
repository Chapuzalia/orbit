# Copy to .env.mcp.local. These are server-side variables; never use NEXT_PUBLIC for secrets.
ORBIT_POCKETBASE_URL=http://127.0.0.1:8090
ORBIT_USER_EMAIL=agente@tu-dominio.com
ORBIT_USER_PASSWORD=CAMBIA_ESTA_CONTRASENA
# Alternative to email/password: a users token (not a superuser token).
# ORBIT_USER_TOKEN=
# Optional: pin the account to one workspace, rejecting mismatches.
# ORBIT_ORGANIZATION_ID=

ORBIT_MCP_TRANSPORT=stdio
ORBIT_MCP_READ_ONLY=false
ORBIT_MCP_ALLOW_SECRETS=false

# Remote Streamable HTTP: use a separate random token, at least 32 characters.
# ORBIT_MCP_TRANSPORT=http
# ORBIT_MCP_HTTP_TOKEN=
# ORBIT_MCP_HOST=127.0.0.1
# ORBIT_MCP_PORT=3100
# ORBIT_MCP_ALLOWED_HOSTS=127.0.0.1,localhost,mcp.tu-dominio.com
# ORBIT_MCP_ALLOWED_ORIGINS=https://tu-cliente-mcp.com
